{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Nginx Web Server Values",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "description": "Number of replicas for the Nginx deployment.",
      "default": 1
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "description": "Nginx image repository.",
          "default": "nginx"
        },
        "pullPolicy": {
          "type": "string",
          "description": "Image pull policy.",
          "default": "IfNotPresent"
        },
        "tag": {
          "type": "string",
          "description": "Nginx image tag.",
          "default": "1.25.3"
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "Kubernetes service type.",
          "default": "ClusterIP"
        },
        "port": {
          "type": "integer",
          "description": "Port for the Nginx service.",
          "default": 80
        }
      }
    }
  }
}
